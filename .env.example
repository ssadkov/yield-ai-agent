# Copy to .env.local (never commit secrets). Details: docs/env.md and the README.

# Required for the private chat. Server only. Get it at https://cloud.near.ai and set a spend limit.
NEAR_AI_API_KEY=

# Optional: AI credits, wallet sign-in, the no-wallet trial and the Open chat lock.
# Without DATABASE_URL the chat is open to anyone who can reach the server.
# DATABASE_URL=
# SESSION_SECRET=
# CREDITS_RECEIVER=
# CREDITS_DESTINATION_ASSET=
# ADVISOR_FREE_USD_PER_MONTH=0.05
# ADVISOR_TRIAL_REQUESTS_PER_DAY=10
# ADVISOR_TRIAL_USD_PER_DAY=0.1

# Optional: which NEAR AI staking position the pool meter reads.
# AI_POOL_NEAR_ACCOUNT=
# AI_POOL_PRODUCT_ID=

# Optional: upstreams.
# SOLANA_RPC_URL=
# SOLANA_SAFE_API_ORIGIN=
# YIELD_AI_API_ORIGIN=
